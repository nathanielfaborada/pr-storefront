{
  "name": "pr-storefront-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "P&R Thrift & Style Collection Monolith - Frontend & Backend Workspaces",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "vintage",
    "thrift",
    "streetwear",
    "storefront",
    "react",
    "vite",
    "express"
  ],
  "author": "P&R Development Team",
  "license": "MIT"
}
